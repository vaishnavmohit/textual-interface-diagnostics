# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- LLM provider credentials ---
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# --- Ollama backend selection ---
# The model name decides per call which client is used. Cloud models (or names
# ending in '-cloud') route to https://ollama.com via OLLAMA_API_KEY; everything
# else goes to OLLAMA_HOST (defaults to http://localhost:11434 when unset).
OLLAMA_API_KEY=
OLLAMA_HOST=

# --- Data / output roots (configs interpolate these) ---
# Set to absolute paths on HPC; defaults run from the repo checkout.
DATA_DIR=./data
OUTPUT_DIR=./output
# Root of the raw benchmark images, used by the DVRL (multi-image) paradigm.
DVRL_IMAGE_DIR=
